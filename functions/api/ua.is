// functions/api/ua.js
// 用来抓取客户端的 User-Agent，返回一份极简 Clash 配置
// 把 UA 写在 YAML 注释里，FlyClash 正常导入后，你在软件里查看配置文本就能看到 UA。

export async function onRequestGet(context) {
  const { request } = context;
  const uaRaw = request.headers.get("user-agent") || "unknown-UA";

  // 注释行里不能有换行符，替换掉 \r \n 即可
  const uaLine = uaRaw.replace(/\r/g, " ").replace(/\n/g, " ");

  const yaml = `port: 7890
socks-port: 0
mode: Rule
log-level: info
allow-lan: true

# UA: ${uaLine}

proxies: []
proxy-groups: []
rules:
  - MATCH,DIRECT
`;

  return new Response(yaml, {
    status: 200,
    headers: {
      "content-type": "text/plain; charset=utf-8",
    },
  });
}
